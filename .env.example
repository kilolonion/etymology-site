# 走 HTTPS 时设为 1（登录 Cookie 只经 HTTPS 发送）
COOKIE_SECURE=1
# “今天”按哪个时区算
TZ_NAME=Asia/Shanghai
# 推送联系方式，建议填你的邮箱
VAPID_SUBJECT=mailto:you@example.com
# 监听地址与端口（Docker 里已设为 0.0.0.0:8787）
# HOST=127.0.0.1
# PORT=8787

# ---- 邮件日报（选填；不配 SMTP_HOST / MAIL_FROM 就不发信，后台仍可预览）----
# 信里的链接、退订链接都用这个地址
# SITE_URL=https://words.kilolonion.com
# SMTP 服务器：465 端口默认直连 TLS，其余端口默认 STARTTLS；本机调试服务器可设 SMTP_SECURE=off
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=ssl
# SMTP_USER=daily@example.com
# SMTP_PASS=
# 发件人（要和 SMTP 账号匹配，否则多半被拒或进垃圾箱）
# MAIL_FROM=词源一日 <daily@example.com>
# MAIL_REPLY_TO=you@example.com
