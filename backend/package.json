{
  "name": "etymology-daily-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "FRONTEND_DIR=../frontend node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "admin": "node --disable-warning=ExperimentalWarning scripts/admin.ts",
    "validate": "node --disable-warning=ExperimentalWarning scripts/validate-entries.ts data/entries.json",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
