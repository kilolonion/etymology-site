# 复制成 deploy/deploy.env 再按需修改（deploy.env 不进 git）。不写的项用下面的默认值。

# ssh 别名（~/.ssh/config 里的 Host），写 local 表示部署到本机目录（测试用）
DEPLOY_HOST=overseas
# 服务器上的项目目录
DEPLOY_DIR=/opt/etymology-site
# 服务器上 node / npm 所在目录（系统自带的 node 22 跑不了 TS）
NODE_BIN=/opt/node24/bin
# systemd 服务名，以及它用哪个用户运行
SERVICE=etymology
SERVICE_USER=ety
# 重启命令、出错时看日志的命令、健康检查地址
# RESTART_CMD="systemctl restart etymology"
# LOGS_CMD="journalctl -u etymology -n 30 --no-pager"
# HEALTH_URL=http://127.0.0.1:8787/api/auth
